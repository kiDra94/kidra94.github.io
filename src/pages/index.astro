---
import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { getCollection } from "astro:content";

const projects = await getCollection("projects");
const sortedProjects = projects.sort((a, b) => a.data.order - b.data.order);
const baseUrl = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="Drazen Plavsic | Software Engineer">
  <section class="mb-20 md:mb-28">
    <p
      class="text-sm font-semibold tracking-wider text-indigo-600 dark:text-indigo-400 uppercase mb-3"
    >
      Hi, I am a
    </p>
    <h1
      class="text-4xl md:text-5xl font-bold tracking-tight text-zinc-950 dark:text-white mb-6 leading-tight"
    >
      Junior Software Engineer for backend, frontend and full-stack work.
    </h1>
    <p
      class="text-base md:text-lg text-zinc-600 dark:text-zinc-400 leading-relaxed max-w-2xl mb-8"
    >
      I build well-tested software, from data-heavy backends in Python and
      Neo4j to front ends in Vue. I'm currently looking for a junior position
      and I'm open to backend, frontend and full-stack roles alike.
    </p>
    <div class="flex gap-4">
      <a
        href="#projects"
        class="px-5 py-3 bg-zinc-900 text-white dark:bg-white dark:text-zinc-950 text-sm font-medium rounded-lg hover:bg-zinc-800 dark:hover:bg-zinc-100 transition-colors shadow-sm"
      >
        Projects
      </a>
      <a
        href="#contact"
        class="px-5 py-3 border border-zinc-200 dark:border-zinc-800 text-sm font-medium rounded-lg hover:bg-zinc-100 dark:hover:bg-zinc-900 transition-colors"
      >
        Contact me
      </a>
    </div>
  </section>

  <section id="projects" class="mb-20 md:mb-28 scroll-mt-20">
    <h2
      class="text-2xl font-bold tracking-tight text-zinc-950 dark:text-white mb-8"
    >
      Portfolio Projects
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {
        sortedProjects.map((project) => (
          <ProjectCard
            title={project.data.title}
            description={project.data.description}
            tags={project.data.tags}
            githubUrl={project.data.githubUrl}
            liveUrl={project.data.liveUrl}
            detailUrl={`${baseUrl}/projects/${project.id}/`}
          />
        ))
      }
    </div>
  </section>

  <section id="about" class="mb-20 md:mb-28 scroll-mt-20">
    <h2
      class="text-2xl font-bold tracking-tight text-zinc-950 dark:text-white mb-6"
    >
      About me
    </h2>
    <div
      class="text-zinc-600 dark:text-zinc-400 space-y-4 leading-relaxed max-w-2xl"
    >
      <p>
        Hi, I'm Drazen, a software engineer based in Graz, Austria. I come
        from technical operations and quality assurance, so I know what
        reliability and precision are worth. Today I put that experience into
        clean, maintainable and well-tested code while studying at HTL Bulme.
      </p>

      <p class="font-medium text-zinc-900 dark:text-zinc-100 pt-2">
        My technical and creative toolbox includes:
      </p>

      <ul class="list-disc list-outside space-y-2 ml-5 marker:text-indigo-500">
        <li>
          <strong class="font-semibold text-zinc-900 dark:text-zinc-100"
            >Frontend & UI:</strong
          > Vue.js, JavaScript, HTML, and CSS for intuitive user interfaces.
        </li>
        <li>
          <strong class="font-semibold text-zinc-900 dark:text-zinc-100"
            >Backend & Databases:</strong
          > Python with FastAPI, Nest.js with Prisma, SQL and Neo4j for robust,
          well-structured data management.
        </li>
        <li>
          <strong class="font-semibold text-zinc-900 dark:text-zinc-100"
            >Testing & Delivery:</strong
          > pytest, Testcontainers, Docker and GitHub Actions — tests that run
          against the real database, not only against mocks.
        </li>
        <li>
          <strong class="font-semibold text-zinc-900 dark:text-zinc-100"
            >Digital Media:</strong
          > Professional photo editing and retouching in Lightroom and Photoshop.
        </li>
      </ul>

      <p class="pt-2">
        I enjoy building practical tools—from data dashboards to a graph-based ERP
        backend. I value transparent communication and solid results, and I'm
        looking for a team where I can grow as an engineer.
      </p>
    </div>
  </section>

  <section id="contact" class="scroll-mt-20">
    <h2
      class="text-2xl font-bold tracking-tight text-zinc-950 dark:text-white mb-4"
    >
      Get in touch
    </h2>
    <p class="text-zinc-600 dark:text-zinc-400 mb-8 max-w-md leading-relaxed">
      Looking for a junior backend, frontend or full-stack engineer? I'd be glad
      to hear from you. Drop me a message or check out my profiles below.
    </p>

    <div class="flex flex-wrap gap-3">
      <a
        href="mailto:contact@drazenplavsic.dev"
        target="_blank"
        class="px-4 py-3 bg-indigo-50 dark:bg-indigo-950/40 text-indigo-600 dark:text-indigo-400 font-medium text-sm rounded-lg hover:bg-indigo-100 dark:hover:bg-indigo-950/80 transition-colors"
      >
        Email
      </a>
      <a
        href="https://github.com/kiDra94"
        target="_blank"
        rel="noopener noreferrer"
        class="px-4 py-3 border border-zinc-200 dark:border-zinc-800 font-medium text-sm rounded-lg hover:bg-zinc-100 dark:hover:bg-zinc-900 transition-colors text-zinc-700 dark:text-zinc-300"
      >
        GitHub
      </a>
      <a
        href="https://www.linkedin.com/in/drazen-plavsic-036599389/"
        target="_blank"
        rel="noopener noreferrer"
        class="px-4 py-3 border border-zinc-200 dark:border-zinc-800 font-medium text-sm rounded-lg hover:bg-zinc-100 dark:hover:bg-zinc-900 transition-colors text-zinc-700 dark:text-zinc-300"
      >
        LinkedIn
      </a>
    </div>
  </section>
</Layout>
