---
import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { getCollection } from "astro:content";

const projects = await getCollection("projects");
const sortedProjects = projects.sort((a, b) => a.data.order - b.data.order);
---

<Layout title="Drazen Plavsic | Software Develope">
  <section class="mb-20 md:mb-28">
    <p
      class="text-sm font-semibold tracking-wider text-indigo-600 dark:text-indigo-400 uppercase mb-3"
    >
      Hi, I am a
    </p>
    <h1
      class="text-4xl md:text-5xl font-bold tracking-tight text-zinc-950 dark:text-white mb-6 leading-tight"
    >
      Junior Software Developer with focus on writing clean & performant code.
    </h1>
    <p
      class="text-base md:text-lg text-zinc-600 dark:text-zinc-400 leading-relaxed max-w-2xl mb-8"
    >
      I build clean software and digital tools. My goal is to take complex logic
      and turn it into simple, functional applications.
    </p>
    <div class="flex gap-4">
      <a
        href="#projects"
        class="px-5 py-2.5 bg-zinc-900 text-white dark:bg-white dark:text-zinc-950 text-sm font-medium rounded-lg hover:bg-zinc-800 dark:hover:bg-zinc-100 transition-colors shadow-sm"
      >
        Projects
      </a>
      <a
        href="#contact"
        class="px-5 py-2.5 border border-zinc-200 dark:border-zinc-800 text-sm font-medium rounded-lg hover:bg-zinc-100 dark:hover:bg-zinc-900 transition-colors"
      >
        Contact me
      </a>
    </div>
  </section>

  <section id="projects" class="mb-20 md:mb-28 scroll-mt-20">
    <h2
      class="text-2xl font-bold tracking-tight text-zinc-950 dark:text-white mb-8"
    >
      Portfolio Projects
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {
        sortedProjects.map((project) => (
          <ProjectCard
            title={project.data.title}
            description={project.data.description}
            tags={project.data.tags}
            githubUrl={project.data.githubUrl}
          />
        ))
      }
    </div>
  </section>

  <section id="about" class="mb-20 md:mb-28 scroll-mt-20">
    <h2
      class="text-2xl font-bold tracking-tight text-zinc-950 dark:text-white mb-6"
    >
      About me
    </h2>
    <div
      class="text-zinc-600 dark:text-zinc-400 space-y-4 leading-relaxed max-w-2xl"
    >
      <p>
        Hi, I'm Drazen. I'm a versatile software developer based in Graz,
        Austria. Coming from a background in technical operations and quality
        assurance, I know the true value of reliability and precision. Today, I
        translate that experience into writing clean, maintainable code while
        studying at HTL Bulme.
      </p>

      <p class="font-medium text-zinc-900 dark:text-zinc-100 pt-2">
        My technical and creative toolbox includes:
      </p>

      <ul class="list-disc list-outside space-y-2 ml-5 marker:text-indigo-500">
        <li>
          <strong class="font-semibold text-zinc-900 dark:text-zinc-100"
            >Frontend & UI:</strong
          > Vue.js, JavaScript, HTML, and CSS for intuitive user interfaces.
        </li>
        <li>
          <strong class="font-semibold text-zinc-900 dark:text-zinc-100"
            >Backend & Databases:</strong
          > Nest.js, Prisma ORM, and SQL for robust, scalable data management.
        </li>
        <li>
          <strong class="font-semibold text-zinc-900 dark:text-zinc-100"
            >Digital Media:</strong
          > Professional photo editing and retouching in Lightroom and Photoshop.
        </li>
      </ul>

      <p class="pt-2">
        I enjoy building practical tools—from data dashboards to team management
        apps. I am dedicated to exceeding client expectations through
        transparent communication and solid results.
      </p>
    </div>
  </section>

  <section id="contact" class="scroll-mt-20">
    <h2
      class="text-2xl font-bold tracking-tight text-zinc-950 dark:text-white mb-4"
    >
      Get in touch
    </h2>
    <p class="text-zinc-600 dark:text-zinc-400 mb-8 max-w-md leading-relaxed">
      Whether you have a project in mind, need a developer, or just want to
      connect—feel free to reach out. Drop me a message or check out my profiles
      below.
    </p>

    <div class="flex flex-wrap gap-3">
      <a
        href="mailto:drazen.p@live.com"
        class="px-4 py-2 bg-indigo-50 dark:bg-indigo-950/40 text-indigo-600 dark:text-indigo-400 font-medium text-sm rounded-lg hover:bg-indigo-100 dark:hover:bg-indigo-950/80 transition-colors"
      >
        Email
      </a>
      <a
        href="https://github.com/kiDra94"
        target="_blank"
        rel="noopener noreferrer"
        class="px-4 py-2 border border-zinc-200 dark:border-zinc-800 font-medium text-sm rounded-lg hover:bg-zinc-100 dark:hover:bg-zinc-900 transition-colors text-zinc-700 dark:text-zinc-300"
      >
        GitHub
      </a>
      <a
        href="https://www.linkedin.com/in/drazen-plavsic-036599389/"
        target="_blank"
        rel="noopener noreferrer"
        class="px-4 py-2 border border-zinc-200 dark:border-zinc-800 font-medium text-sm rounded-lg hover:bg-zinc-100 dark:hover:bg-zinc-900 transition-colors text-zinc-700 dark:text-zinc-300"
      >
        LinkedIn
      </a>
    </div>
  </section>
</Layout>
