---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";

// One static page per Markdown file in src/content/projects — the card on the start page
// only shows the front matter, the body text lives here.
export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { title, description, tags, githubUrl, liveUrl, liveNote } = project.data;
const { Content } = await render(project);
const baseUrl = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL.replace(/\/$/, '');
const focusRing = "focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-zinc-950 rounded-sm";
---

<Layout title={`${title} | Drazen Plavsic`} description={description}>
  <a
    href={`${baseUrl}/#projects`}
    class={`text-sm font-medium text-indigo-600 dark:text-indigo-400 hover:underline ${focusRing}`}
  >
    ← All projects
  </a>

  <article class="mt-8">
    <h1
      class="text-3xl md:text-4xl font-bold tracking-tight text-zinc-950 dark:text-white mb-4"
    >
      {title}
    </h1>
    <p
      class="text-base md:text-lg text-zinc-600 dark:text-zinc-400 leading-relaxed max-w-2xl mb-6"
    >
      {description}
    </p>

    <div class="flex flex-wrap gap-1.5 mb-6">
      {tags.map((tag) => (
        <span class="text-xs px-2.5 py-1 rounded-md bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400 font-medium">
          {tag}
        </span>
      ))}
    </div>

    <div class="flex flex-wrap items-center gap-3 mb-1">
      {liveUrl && (
        <a
          href={liveUrl}
          target="_blank"
          rel="noopener noreferrer"
          class={`px-4 py-3 bg-indigo-50 dark:bg-indigo-950/40 text-indigo-600 dark:text-indigo-400 font-medium text-sm rounded-lg hover:bg-indigo-100 dark:hover:bg-indigo-950/80 transition-colors ${focusRing}`}
        >
          Live demo
        </a>
      )}
      {githubUrl && (
        <a
          href={githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class={`px-4 py-3 border border-zinc-200 dark:border-zinc-800 font-medium text-sm rounded-lg hover:bg-zinc-100 dark:hover:bg-zinc-900 transition-colors text-zinc-700 dark:text-zinc-300 ${focusRing}`}
        >
          GitHub
        </a>
      )}
    </div>
    {liveUrl && liveNote && (
      <p class="text-xs text-zinc-500 dark:text-zinc-500 mb-12">{liveNote}</p>
    )}
    {!(liveUrl && liveNote) && <div class="mb-12" />}

    <div class="project-body max-w-2xl">
      <Content />
    </div>
  </article>
</Layout>

<style>
  /* The Markdown body arrives as plain HTML without classes. Without the Tailwind typography
     plugin these few rules give it the same look as the rest of the page. */
  .project-body {
    color: theme('colors.zinc.600');
  }
  .project-body :global(p) {
    margin-bottom: 1rem;
    line-height: 1.75;
  }
  .project-body :global(h3) {
    margin: 2rem 0 0.75rem;
    font-size: 1.125rem;
    font-weight: 600;
    color: theme('colors.zinc.900');
  }
  .project-body :global(ul) {
    list-style: disc;
    padding-left: 1.25rem;
    margin-bottom: 1rem;
  }
  .project-body :global(li) {
    margin-bottom: 0.5rem;
    line-height: 1.75;
  }
  .project-body :global(li::marker) {
    color: theme('colors.indigo.600');
  }
  .project-body :global(strong) {
    font-weight: 600;
    color: theme('colors.zinc.900');
  }
  .project-body :global(code) {
    font-size: 0.875em;
    padding: 0.125rem 0.375rem;
    border-radius: 0.375rem;
    background: theme('colors.zinc.100');
  }
  .project-body :global(a) {
    color: theme('colors.indigo.600');
    text-decoration: underline;
  }
  .project-body :global(blockquote) {
    margin: 1.25rem 0;
    padding: 0.75rem 1rem;
    border-left: 3px solid theme('colors.indigo.500');
    background: theme('colors.indigo.50');
    border-radius: 0.375rem;
  }
  .project-body :global(blockquote p) {
    margin-bottom: 0;
    font-size: 0.9em;
  }

  @media (prefers-color-scheme: dark) {
    .project-body {
      color: theme('colors.zinc.400');
    }
    .project-body :global(h3),
    .project-body :global(strong) {
      color: theme('colors.white');
    }
    .project-body :global(code) {
      background: theme('colors.zinc.800');
    }
    .project-body :global(a) {
      color: theme('colors.indigo.400');
    }
    .project-body :global(blockquote) {
      background: theme('colors.indigo.950 / 40%');
      border-left-color: theme('colors.indigo.400');
    }
  }
</style>
