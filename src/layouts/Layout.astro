---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Drazen Plavsic, junior software engineer in Graz, Austria, open to backend, frontend and full-stack roles. Projects in Python, FastAPI, Neo4j, Vue and C++.",
} = Astro.props;

// Absolute URLs built from `site` in astro.config.mjs. The canonical link also tells search
// engines that the GitHub Pages copy of this site is a duplicate of drazenplavsic.dev.
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og-image.png", Astro.site);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Drazen Plavsic" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Drazen Plavsic, junior software engineer" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  </head>
  <body class="bg-zinc-50 text-zinc-800 dark:bg-zinc-950 dark:text-zinc-200 antialiased transition-colors duration-300 min-h-screen flex flex-col selection:bg-indigo-500 selection:text-white">
    <Navbar />
    <main class="flex-grow max-w-4xl w-full mx-auto px-6 py-12 md:py-20">
      <slot />
    </main>
    <Footer />
  </body>
</html>