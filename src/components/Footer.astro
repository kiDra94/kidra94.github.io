---
const baseUrl = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL.replace(/\/$/, '');
---
<footer class="border-t border-zinc-200/50 dark:border-zinc-800/50 py-8 text-center">
  <div class="max-w-4xl mx-auto px-6">
    <p class="text-sm text-zinc-600 dark:text-zinc-400">
      Open to junior backend, frontend and full-stack roles —
      <a
        href={`${baseUrl}/#contact`}
        class="font-medium text-indigo-600 dark:text-indigo-400 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-zinc-950 rounded-sm"
        >let's talk</a
      >.
    </p>
    <p class="text-xs text-zinc-400 dark:text-zinc-600 mt-2">
      &copy; {new Date().getFullYear()} Drazen Plavsic
    </p>
  </div>
</footer>
