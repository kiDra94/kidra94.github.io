---
const baseUrl = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL.replace(/\/$/, '');
const focusRing = "focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-zinc-950 rounded-sm";
---
<header class="w-full border-b border-zinc-200/50 dark:border-zinc-800/50 sticky top-0 backdrop-blur-md bg-zinc-50/80 dark:bg-zinc-950/80 z-50">
  <div class="max-w-4xl w-full mx-auto px-6 h-16 flex items-center justify-between">
    <a href={`${baseUrl}/`} class={`font-semibold tracking-tight text-zinc-900 dark:text-white hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors ${focusRing}`}>
      &lt;dev/&gt;
    </a>
    <nav class="flex gap-6 text-sm font-medium">
      <a href={`${baseUrl}/#projects`} class={`hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors ${focusRing}`}>Projects</a>
      <a href={`${baseUrl}/#about`} class={`hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors ${focusRing}`}>About Me</a>
      <a href={`${baseUrl}/#contact`} class={`hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors ${focusRing}`}>Contact</a>
    </nav>
  </div>
</header>